    {
      "name": "1. Signup / Registration",
      "item": [
        {
          "name": "Signup - Success (201 Created)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randomNum = Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set('unique_email', `testuser_${randomNum}@factscan.ai`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Returns success true and user object', function () {",
                  "    pm.expect(res.success).to.eql(true);",
                  "    pm.expect(res.user).to.be.an('object');",
                  "    pm.expect(res.user.id).to.be.a('number');",
                  "});",
                  "",
                  "if (res.user && res.user.id) {",
                  "    pm.collectionVariables.set('user_id', res.user.id.toString());",
                  "    pm.collectionVariables.set('test_email', res.user.email);",
                  "    console.log('Saved user_id:', res.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Alex Morgan\",\n  \"email\": \"{{unique_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"language\": \"English\",\n  \"accent_color\": \"blue\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/signup.php",
              "host": ["{{base_url}}"],
              "path": ["signup.php"]
            },
            "description": "Registers a new user account with unique email. Saves the newly created user_id to collection variables automatically."
          }
        },
        {
          "name": "Signup - Error: Missing Fields (400 Bad Request)",
